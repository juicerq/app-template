{
	"name": "app-template",
	"version": "0.0.0",
	"private": true,
	"description": "PLACEHOLDER — descrição do app",
	"author": "PLACEHOLDER",
	"homepage": "PLACEHOLDER",
	"repository": "PLACEHOLDER",
	"productName": "PLACEHOLDER",
	"appId": "PLACEHOLDER",
	"type": "module",
	"main": "./out/main/index.js",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
		"build": "electron-vite build",
		"preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
		"dist": "electron-vite build && electron-builder --publish never",
		"dist:linux": "electron-vite build && electron-builder --linux --publish never",
		"dist:win": "electron-vite build && electron-builder --win --publish never",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@orpc/client": "^1.14.0",
		"@orpc/server": "^1.14.0",
		"@orpc/tanstack-query": "^1.14.0",
		"@tanstack/react-query": "^5.99.2",
		"@tanstack/react-router": "^1.168.23",
		"arktype": "^2.2.0",
		"better-sqlite3": "^12.0.0",
		"drizzle-orm": "^0.45.2",
		"electron-updater": "^6.8.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/router-plugin": "^1.167.22",
		"@types/better-sqlite3": "^7.6.13",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.0",
		"bun-types": "^1.3.13",
		"drizzle-kit": "^0.31.10",
		"electron": "^33.0.0",
		"electron-builder": "^25.1.8",
		"electron-vite": "^4.0.0",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.0",
		"vite": "^6.0.0",
		"vitest": "^4.1.5"
	}
}
